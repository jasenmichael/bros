# These commented values are the defaults already used.
# No .env is needed. Bros and Compose apply these defaults when the vars are unset.
# To override: cp example.env .env, uncomment the lines you want, and change the values.
# Server settings live in $BROS_DIR/bros.yml. Session secret is {dataDir}/session-secret,
# Compose reads a repo-root .env only for ${...} substitution when that file exists.

# Host / process
# CLI: when unset, BROS_DIR and BROS_HOME are the realpath directory of the bros script
# (resolve_bros_dir / SCRIPT_DIR). Explicit BROS_DIR wins. BROS_HOME alone still aliases.
# Compose sets BROS_DIR=/app inside the container (Dockerfile / docker-compose.yml) — do not override that.
# BROS_DIR=
# BROS_HOME=$BROS_DIR
# BROS_BIN=$HOME/.local/bin/bros
# BROS_DATA_DIR=$BROS_DIR/data
# BROS_HOST_DATA_DIR=$BROS_DATA_DIR
# BROS_PORT=3055
# Only BROS_DEV=1 selects docker-compose.dev.yml (bros:L30). 0 matches unset.
# BROS_DEV=0
# Overrides bros.yml public_url when set (config.ts). Default: empty / unset.
# BROS_PUBLIC_URL=
# BROS_CONFIG=$BROS_DIR/bros.yml
# BROS_CONFIG_HOST=$BROS_DIR/bros.yml
# BROS_WORKING_DIR=$BROS_DIR
# BROS_REPO=https://github.com/jasenmichael/bros.git
# BROS_REF=main

# Compose user and socket
# BROS_HOST_UID=1000
# BROS_HOST_GID=1000
# BROS_DOCKER_GID=0
# BROS_HOST_HOME_BIND=$HOME
# BROS_HOST_GATEWAY=host.docker.internal

# Sidecars (0 / false / off / no skips autostart; 1 matches enabled / unset)
# BROS_SIDECARS_DISABLE does not disable ollama or whisper (sidecars.ts:disabledAddonIds).
# Host directory for user sidecar packs. Inside the app container this is /app/sidecars/custom.
# BROS_SIDECARS_DIR=$BROS_DIR/sidecars
# Default: empty (no addon ids skipped).
# BROS_SIDECARS_DISABLE=
# BROS_SIDECAR_OPENCODE=1
# BROS_SIDECAR_OPENWEBUI=1
# BROS_SIDECAR_FIRECRAWL=1
# BROS_SIDECAR_FIRECRAWL_UI=1
# BROS_SIDECAR_OPENJEV=1
# BROS_NETWORK=bros
# BROS_OLLAMA_PORT=11435
# BROS_OPENCODE_PORT=4097
# BROS_OPENWEBUI_PORT=3080
# BROS_FIRECRAWL_PORT=3002
# BROS_FIRECRAWL_UI_PORT=3081
# BROS_WHISPER_PORT=8090
# BROS_OPENJEV_PORT=8092
# Custom starters under sidecars/ (see docs/sidecars/custom.md)
# BROS_OPEN_SEO_PORT=3001
# BROS_OCTOP_PORT=8088
# BROS_PAPERCLIP_PORT=3100
# BROS_OPENHANDS_PORT=8000
# BROS_OMNIROUTE_PORT=20128
# BROS_TRUEFORGE_PORT=8791
# DATAFORSEO_API_KEY=
# OCTOP_DEFAULT_PASSWORD=
# LOCAL_BACKEND_API_KEY=
# OMNIROUTE_MEMORY_MB=1024
# BROS_FIRECRAWL_POSTGRES_PASSWORD=bros-firecrawl-local-trusted-network-only-32b

# Tunnel
# scripts/bros-tunnel.sh: ${BROS_TUNNEL_DIR:-${BROS_HOST_DATA_DIR:-${BROS_DIR:-.}/data}/tunnel}
# BROS_TUNNEL_DIR=$BROS_HOST_DATA_DIR/tunnel
# BROS_TUNNEL_NAME=bros
# BROS_TUNNEL_ROUTE_TIMEOUT=20
# BROS_TUNNEL_PROTOCOL=http2
# BROS_TUNNEL_EDGE_IP_VERSION=4
# true / false / 1 / 0 / on / off / no / yes. Gets a temporary domain via cloudflare tunnel, unless BROS_TUNNEL_HOST is set.
# BROS_TUNNEL=false 
# Optional Host match for via-tunnel (viaTunnel.ts). Default: empty / unset.
# BROS_TUNNEL_HOST=
