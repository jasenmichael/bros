# Defaults already apply. No .env is needed.
# cp example.env .env, then uncomment a line. A same-line " # comment" is ignored.
# $HOME / ${HOME} / ~ expand; $BROS_HOME expands for BROS_HOST_DATA_DIR.
# A var already set in the shell wins. Empty values are skipped.
# Do not put a real key or tunnel hostname in this file.

# Host
# BROS_DIR and BROS_HOME default to the realpath of the bros script. BROS_HOME alone aliases. install.sh uses ~/.bros. Container BROS_DIR is /app.
# BROS_DIR= # script directory
# BROS_HOME= # same as BROS_DIR
# BROS_BIN=$HOME/.local/bin/bros # symlink to $BROS_DIR/bros
# BROS_HOST_DATA_DIR=$BROS_HOME/data # persistent binds
# BROS_HOST_WORKSPACE=$BROS_HOST_DATA_DIR/home/workspace # Desktop workspace bind
# BROS_HOST_REPO= # directory of the bros script
# BROS_HOST_HOME_BIND=$HOME # host home bind
# BROS_PORT=3055 # app port
# BROS_HOST=0.0.0.0 # listen address; 127.0.0.1 stays on this machine
# BROS_DEV=0 # 1 selects docker-compose.dev.yml, same as ./bros --dev
# BROS_USE_RUNNER=0 # 1 starts container bros-ui even when host pnpm is on PATH. Same as ./bros --use-runner. Dev with 1 errors
# BROS_NODE_VERSION= # node -v where ./bros runs, else 26.7.0. Desktop nodejs pin
# BROS_DEVBOX_VERSION=0.18.4 # Desktop Devbox binary pin. Applies on the next Desktop image build

# User
# BROS_HOST_UID= # id -u
# BROS_HOST_GID= # id -g
# BROS_HOST_GATEWAY=host.docker.internal # host probe from the app container
# BROS_NETWORK=bros # Docker network; created when missing

# Docker apps
# Unset does not start an addon. 0, false, off, or no skips it. Autostart is SQLite and defaults off. Ollama, Desktop, and Whisper ignore these.
# BROS_APPS_DISABLE= # empty; comma list of addon ids
# BROS_APP_OPENCODE=0 # compose default; listed, no autostart, Start still works, id reserved
# BROS_APP_OPENWEBUI= # unset
# BROS_APP_FIRECRAWL= # unset
# BROS_APP_FIRECRAWL_UI= # unset
# BROS_APP_OPENJEV= # unset
# BROS_APP_PI= # unset
# BROS_APP_OMNIROUTE= # unset

# Host ports
# In-container Bros uses Docker DNS, not these.
# BROS_OLLAMA_PORT=11435 # docker app Ollama
# BROS_OPENCODE_PORT=4097 # OpenCode
# BROS_OPENWEBUI_PORT=3080 # Open WebUI
# BROS_FIRECRAWL_PORT=3002 # Firecrawl API
# BROS_FIRECRAWL_UI_PORT=3081 # Firecrawl UI
# BROS_WHISPER_PORT=8090 # Whisper
# BROS_OPENJEV_PORT=8092 # OpenJEV
# BROS_OMNIROUTE_PORT=20128 # OmniRoute dashboard and /v1
# OMNIROUTE_JWT_SECRET= # else $BROS_HOST_DATA_DIR/apps/omniroute/.env; not pack .env

# Firecrawl
# BROS_FIRECRAWL_POSTGRES_PASSWORD=bros-firecrawl-local-trusted-network-only-32b # local Postgres only
# POSTGRES_USER=postgres # Firecrawl Postgres user
# POSTGRES_DB=postgres # Firecrawl Postgres database
# NUM_WORKERS_PER_QUEUE=8 # Firecrawl workers per queue
# CRAWL_CONCURRENT_REQUESTS=10 # Firecrawl concurrent requests
# MAX_CONCURRENT_JOBS=5 # Firecrawl concurrent jobs
# BROWSER_POOL_SIZE=5 # Firecrawl browser pool
# HARNESS_STARTUP_TIMEOUT_MS=60000 # Firecrawl harness startup

# OpenJEV
# OPENJEV_GPU_UTIL=0.80 # GPU memory fraction
# OPENJEV_VLLM_ARGS=--kv-cache-dtype bfloat16 # vLLM args
# OPENJEV_DEVICE=cpu # encoder device; cuda when VRAM allows
# OPENJEV_MAX_NUM_SEQS=64 # max sequences
# OPENJEV_MAX_MODEL_LEN=65536 # max model length
# OPENJEV_MODEL_ROUTES=laya-1.0=http://laya:8080,verdict-1.4=http://verdict:8080 # encoder routes

# Sidecar keys
# Empty. Not a Providers bootstrap.
# ANTHROPIC_API_KEY= # Pi
# OPENAI_API_KEY= # Pi
# GEMINI_API_KEY= # Pi
# OPENJEV_API_KEY= # OpenJEV
# OPENJEV_ORIGIN_SECRET= # OpenJEV
# HF_TOKEN= # OpenJEV Hugging Face
# GH_TOKEN= # Agents page. On start, replaces the stored token when set. Else GITHUB_TOKEN, else GITHUB_PAT

# Tunnel
# BROS_PUBLIC_URL= # empty; wins over BROS_TUNNEL_HOST and YAML public_url
# BROS_TUNNEL_HOST= # empty; hostname when public_url is unset
# BROS_TUNNEL_DIR=$BROS_HOST_DATA_DIR/var/tunnel # helper files
# BROS_TUNNEL_NAME=bros # named tunnel
# BROS_TUNNEL_ROUTE_TIMEOUT=20 # seconds for route dns
# BROS_TUNNEL_PROTOCOL=http2 # http2, quic, or auto
# BROS_TUNNEL_EDGE_IP_VERSION=4 # 4, 6, or auto
