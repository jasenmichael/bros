# Defaults already apply. No .env is needed.
# cp example.env .env, then uncomment a line. Same-line " # comment" is ignored.
# This file is read from the real binary's directory (not the BROS_BIN symlink dir).
# $HOME / ${HOME} / ~ expand; $BROS_DIR expands for BROS_DATA_DIR.
# Shell env wins. Empty values are skipped.
# Do not put secrets or a personal tunnel URL in this file.

# BROS_DIR=                              # runtime override; install.sh default ~/.bros (bin location)
# BROS_BIN=$HOME/.local/bin/bros         # install symlink to $BROS_DIR/bros (not used to find .env)
# BROS_DATA_DIR=$BROS_DIR/data           # persistent binds + UI data (SQLite, logs, Desktop home)
# BROS_WORKSPACE=$BROS_DATA_DIR/home/workspace  # Desktop workspace bind
# BROS_PORT=3055
# BROS_HOST=0.0.0.0                      # 127.0.0.1 stays on this machine
# BROS_APPS_ENABLED=                     # comma addon ids to start on boot (e.g. openwebui,firecrawl)
# BROS_TUNNEL=                           # opt-in host tunnel: true / 1 / yes (default off)
# BROS_PUBLIC_URL=                       # named hostname; wins over BROS_TUNNEL_HOST / YAML public_url
# BROS_TUNNEL_HOST=                      # named hostname when BROS_PUBLIC_URL unset (do not put a personal URL here)
