#!/bin/bash
# shortcut: abc stays so Selkies scripts keep that name; bros is the same uid listed first. Drop this if Selkies adds a username setting.
if id abc >/dev/null 2>&1; then
  uid=$(id -u abc)
  gid=$(id -g abc)
  if ! id bros >/dev/null 2>&1; then
    useradd --non-unique --no-create-home --uid "$uid" --gid "$gid" --home-dir /home/bros --shell /bin/bash bros
  elif [ "$(id -u bros)" != "$uid" ] || [ "$(id -g bros)" != "$gid" ]; then
    mkdir -p /run/bros-empty
    usermod -d /run/bros-empty bros
    usermod -o -u "$uid" -g "$gid" bros
    usermod -d /home/bros bros
  fi
  if id bros >/dev/null 2>&1; then
    tmp=$(mktemp)
    awk 'BEGIN{FS=OFS=":"} $1=="bros"{b=$0; next} {o[++n]=$0} END{if (b != "") print b; for (i = 1; i <= n; i++) print o[i]}' /etc/passwd > "$tmp"
    if [ -s "$tmp" ] && grep -q '^bros:' "$tmp"; then
      cat "$tmp" > /etc/passwd
    fi
    rm -f "$tmp"
  fi
fi
for f in /etc/sudoers /etc/sudoers.d/*; do
  [ -f "$f" ] || continue
  grep -q '^abc[[:space:]]' "$f" || continue
  while IFS= read -r line; do
    rule=${line#abc}
    grep -qxF "bros${rule}" "$f" || printf 'bros%s\n' "$rule" >> "$f"
  done << EOF
$(grep '^abc[[:space:]]' "$f")
EOF
done
mkdir -p /home/bros/.local/sidecar-bins /home/bros/.local/bin /home/bros/.local/share/pnpm/store /home/bros/.bun/bin /home/bros/.deno/bin /home/bros/.deno/cache /home/bros/workspace /opt/bros/apps /tmp/bros-run
chmod 1777 /tmp/bros-run /tmp/.X11-unix || true
# group_add is only on the s6 root process. foot and ttyd run as abc.
gid=$(stat -c '%g' /var/run/docker.sock 2>/dev/null || true)
if [ -z "$gid" ] || [ "$gid" = "0" ]; then
  gid=${BROS_DOCKER_GID:-0}
fi
if [ "$gid" != "0" ] && id abc >/dev/null 2>&1; then
  name=$(getent group "$gid" | cut -d: -f1)
  if [ -z "$name" ]; then
    groupadd -g "$gid" dockersock
    name=$(getent group "$gid" | cut -d: -f1)
  fi
  [ -n "$name" ] && usermod -aG "$name" abc
fi
# foot reads ~/.bashrc. ttyd sources the same path file.
touch /home/bros/.bashrc
grep -q '/etc/profile.d/bros-path.sh' /home/bros/.bashrc || printf '\n%s\n' '[ -f /etc/profile.d/bros-path.sh ] && . /etc/profile.d/bros-path.sh' >> /home/bros/.bashrc
# In-desktop foot opens in the desktop home workspace.
foot_line='foot --working-directory=/home/bros/workspace'
found=0
for f in \
  /home/bros/.config/labwc/autostart \
  /defaults/autostart_wayland \
  /defaults/autostart
do
  [ -f "$f" ] || continue
  grep -q '^foot\( \|$\)' "$f" || continue
  sed -i "s|^foot.*|$foot_line|" "$f"
  found=1
done
if [ "$found" -eq 0 ]; then
  mkdir -p /home/bros/.config/labwc
  printf '%s\n' "$foot_line" >> /home/bros/.config/labwc/autostart
fi

# Cursor draws its own title bar. labwc's bar is the second min/fullscreen/close row.
mkdir -p /home/bros/.config/labwc
rc=/home/bros/.config/labwc/rc.xml
rule='  <windowRule identifier="*cursor*" serverDecoration="no" />'
if [ ! -f "$rc" ]; then
  cat > "$rc" << EOF
<?xml version="1.0"?>
<labwc_config>
  <windowRules>
$rule
  </windowRules>
</labwc_config>
EOF
elif ! grep -F -q 'identifier="*cursor*"' "$rc"; then
  if grep -q '</windowRules>' "$rc"; then
    sed -i "s|</windowRules>|$rule\n  </windowRules>|" "$rc"
  elif grep -q '</labwc_config>' "$rc"; then
    sed -i "s|</labwc_config>|  <windowRules>\n$rule\n  </windowRules>\n</labwc_config>|" "$rc"
  elif grep -q '</openbox_config>' "$rc"; then
    sed -i "s|</openbox_config>|  <windowRules>\n$rule\n  </windowRules>\n</openbox_config>|" "$rc"
  else
    printf '\n<windowRules>\n%s\n</windowRules>\n' "$rule" >> "$rc"
  fi
fi

# Image bins win over an older copy in the home mount.
shopt -s nullglob
for cfg in /opt/bros/enabled-apps/*/config.yml; do
  [ -f "$cfg" ] || continue
  while read -r name; do
    case "$name" in
      ''|*[!A-Za-z0-9._+-]*) continue ;;
    esac
    if [ -e "/usr/local/bin/$name" ] || [ -e "/usr/bin/$name" ]; then
      target="/home/bros/.local/bin/$name"
      if [ -f "$target" ] || [ -L "$target" ]; then
        rm -f "$target"
      fi
    fi
  done << EOF
$(awk '
  /^bin: / { print $2 }
  /^clis: / {
    line = $0
    sub(/^clis: */, "", line)
    n = split(line, a, ",")
    for (i = 1; i <= n; i++) {
      gsub(/ /, "", a[i])
      if (a[i] != "") print a[i]
    }
  }
' "$cfg")
EOF
done

# Herdr restores a cwd from an older mount. A missing directory keeps the server from listening.
session=/home/bros/.config/herdr/session.json
if [ -f "$session" ] && command -v node >/dev/null 2>&1; then
  missing=$(node - "$session" << 'JS'
const fs = require('fs')
const doc = JSON.parse(fs.readFileSync(process.argv[2], 'utf8'))
const dirs = []
for (const workspace of doc.workspaces || []) {
  if (workspace.identity_cwd) dirs.push(workspace.identity_cwd)
  for (const tab of workspace.tabs || []) {
    for (const pane of Object.values(tab.panes || {})) {
      if (pane && pane.cwd) dirs.push(pane.cwd)
    }
  }
}
const gone = dirs.find((dir) => !fs.existsSync(dir))
if (gone) process.stdout.write(gone)
JS
)
  if [ -n "$missing" ]; then
    mv "$session" "${session}.bak"
  fi
fi

# Chromium's zygote cannot make a namespace here. --disable-chromium-sandbox
# is read after that crash. The electron binary needs --no-sandbox on argv.
if [ -x /usr/bin/cursor ]; then
  cat > /usr/local/bin/cursor << 'EOF'
#!/bin/sh
for arg in "$@"; do
  case "$arg" in
    agent|tunnel|editor|--help|-h|--version|-v|--list-extensions|--show-versions|--status)
      exec /usr/bin/cursor "$@"
      ;;
  esac
done
if [ -n "${BROS_GUI_LAUNCH:-}" ] && [ -x /usr/share/cursor/cursor ]; then
  exec /usr/share/cursor/cursor --no-sandbox "$@"
fi
exec /usr/bin/cursor --no-sandbox "$@"
EOF
  chmod +x /usr/local/bin/cursor
fi

# Nix store stays /nix/store inside the container. The installer runs from ensure.sh when nix is missing.
mkdir -p /nix /etc/nix /home/bros/.local/share/devbox /home/bros/.local/state/nix /var/log/bros/apps
printf '%s\n' 'sandbox = false' 'experimental-features = nix-command flakes' 'build-users-group =' 'use-xdg-base-directories = true' > /etc/nix/nix.conf
