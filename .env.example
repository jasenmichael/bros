# Bros bootstrap / runtime (optional; compose sets most of these)
BROS_PORT=3055
BROS_WORKING_DIR=/app
BROS_DATA_DIR=/data
BROS_SIDECARS_DIR=/app/sidecars
BROS_NETWORK=bros
# Exclusive bootstrap YAML (skips .config/bros.yml and ./bros.yml search)
# BROS_CONFIG=/path/to/bros.yml
# Host path mounted as /app/bros.yml when using ./bros -c
# BROS_CONFIG_HOST=./bros.yml
BROS_SESSION_SECRET=change-me-in-production
