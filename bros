#!/usr/bin/env bash
# Bros CLI — start/stop/status/update via Docker Compose.
set -euo pipefail

resolve_script_dir() {
  local source="$1"
  local dir
  while [[ -L "$source" ]]; do
    dir="$(cd "$(dirname "$source")" && pwd)"
    source="$(readlink "$source")"
    [[ "$source" != /* ]] && source="$dir/$source"
  done
  cd "$(dirname "$source")" && pwd
}

SCRIPT_DIR="$(resolve_script_dir "${BASH_SOURCE[0]}")"
REPO_ROOT="$SCRIPT_DIR"
cd "$REPO_ROOT"

VERSION="0.1.0"
if [[ -f "$REPO_ROOT/package.json" ]]; then
  _pkg_ver="$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$REPO_ROOT/package.json" | head -1)"
  [[ -n "${_pkg_ver:-}" ]] && VERSION="$_pkg_ver"
fi
[[ -f "$REPO_ROOT/VERSION" ]] && VERSION="$(tr -d '[:space:]' <"$REPO_ROOT/VERSION")"

# Defaults: prod compose files, interactive (foreground) up.
# BROS_DEV=1 selects docker-compose.dev.yml (pnpm dev). Not a CLI flag.
DEV=0
[[ "${BROS_DEV:-}" == "1" ]] && DEV=1
DAEMON=0
CONFIG_PATH=""
COMMAND=""
SERVICE_ACTION=""

usage() {
  cat <<EOF
Bros $VERSION — local AI control plane (Docker Compose)

Usage:
  bros [-h|--help] [-v|--version]
  bros [options]                 start (interactive, production compose)
  bros <command> [options]

Default action (no command): start (up; prod also --build)

Commands:
  start              Same as default (optional explicit alias)
  stop               Stop Bros core + all bros-sc-* sidecars (data dirs kept)
  status             Show compose ps and health check
  restart            Stop then start (same flags)
  check              Check for git/image/model updates; prompt to update if any
  update             Git pull, submodule, images, rebuild (alias: upgrade)
  service install    systemd --user unit (Linux; runs bros -D)
  service uninstall  Disable and remove the user unit
  service status     systemctl --user status bros

Options:
  -D, --daemon       Background: docker compose up --build -d
                     (ignored when BROS_DEV=1; dev is always interactive)
  -i, --interactive  Foreground (default). Ctrl+C / SIGTERM runs compose down
  -c, --config PATH  Bootstrap YAML; sets BROS_CONFIG (mounted into container)
  -h, --help         Show this help
  -v, --version      Show version

Env:
  BROS_HOME          Checkout dir (default: this script's repo, else ~/.bros)
  BROS_DIR           Alias for BROS_HOME
  BROS_CONFIG        Host bootstrap YAML (default: ~/.config/bros.yml)
  BROS_BIN           PATH symlink (default: ~/.local/bin/bros)
  BROS_HOST_DATA_DIR Persistent binds; default \$BROS_HOME/data
  BROS_PORT          App host port (default 3055); tunnel helper targets this
  BROS_DEV=1         Dev compose (pnpm dev); not a CLI flag

Examples:
  bros
  bros -D
  bros -c ~/.config/bros.yml
  bros status
  bros check
  bros update
  bros service install
EOF
}

die() {
  echo "error: $*" >&2
  exit 1
}

# Host tunnel helper (not a sidecar). Sourced functions live in scripts/.
# shellcheck source=scripts/bros-tunnel.sh
. "$REPO_ROOT/scripts/bros-tunnel.sh"

preflight() {
  if ! command -v docker >/dev/null 2>&1; then
    die "Docker is not installed or not on PATH. Install Docker: https://docs.docker.com/get-docker/"
  fi
  if ! docker info >/dev/null 2>&1; then
    die "Docker daemon is not reachable. Start Docker and retry (tried: docker info)."
  fi
  if ! docker compose version >/dev/null 2>&1; then
    die "Docker Compose plugin missing. Need 'docker compose' (v2 plugin), not only 'docker-compose'."
  fi
  # Host path for /host-home binds (sidecars started from inside the app inherit this)
  export BROS_HOST_HOME_BIND="${BROS_HOST_HOME_BIND:-${HOME}}"
  # App container must write bind-mounted files as the host user (not root).
  export BROS_HOST_UID="$(id -u)"
  export BROS_HOST_GID="$(id -g)"
  # docker.sock is typically root:docker (660). Join that group instead of running as root.
  _docker_gid="$(getent group docker 2>/dev/null | cut -d: -f3 || true)"
  if [[ -n "${_docker_gid}" ]]; then
    export BROS_DOCKER_GID="${_docker_gid}"
  else
    export BROS_DOCKER_GID=0
    echo "warning: no docker group; BROS_DOCKER_GID=0 so the app can still use /var/run/docker.sock" >&2
  fi
  resolve_bros_dir
  ensure_host_data_dir
  export BROS_PORT="${BROS_PORT:-3055}"
}

# Repo checkout (compose + sidecars next to this script) vs installed (~/.bros).
resolve_bros_dir() {
  if [[ -n "${BROS_HOME:-}" ]]; then
    :
  elif [[ -n "${BROS_DIR:-}" ]]; then
    BROS_HOME="$BROS_DIR"
  elif [[ -f "$SCRIPT_DIR/docker-compose.yml" && -d "$SCRIPT_DIR/sidecars" ]]; then
    BROS_HOME="$SCRIPT_DIR"
  else
    BROS_HOME="${HOME}/.bros"
  fi
  export BROS_HOME
  export BROS_DIR="${BROS_DIR:-$BROS_HOME}"
  export BROS_HOST_DATA_DIR="${BROS_HOST_DATA_DIR:-${BROS_HOME}/data}"
  export BROS_BIN="${BROS_BIN:-${HOME}/.local/bin/bros}"
}

xdg_config_path() {
  printf '%s\n' "${XDG_CONFIG_HOME:-$HOME/.config}/bros.yml"
}

# Host YAML: -c, else BROS_CONFIG file, else ~/.config/bros.yml, else $BROS_HOME/bros.yml.
resolve_default_config() {
  if [[ -n "${BROS_CONFIG:-}" && "$BROS_CONFIG" != "/app/bros.yml" && -f "$BROS_CONFIG" ]]; then
    printf '%s\n' "$BROS_CONFIG"
    return 0
  fi
  local xdg
  xdg="$(xdg_config_path)"
  if [[ -f "$xdg" ]]; then
    printf '%s\n' "$xdg"
    return 0
  fi
  if [[ -f "${BROS_HOME:-}/bros.yml" ]]; then
    printf '%s\n' "${BROS_HOME}/bros.yml"
    return 0
  fi
  return 1
}

move_if_missing() {
  local from="$1" to="$2"
  [[ -e "$from" ]] || return 0
  if [[ -e "$to" ]]; then
    # Empty dir from a failed copy is not a finished migration.
    if [[ -d "$to" ]] && [[ -z "$(find "$to" -mindepth 1 -print -quit)" ]]; then
      rmdir "$to" || return 0
    else
      return 0
    fi
  fi
  mkdir -p "$(dirname "$to")"
  mv "$from" "$to"
}

# Flat volume dir becomes data/<id>/<container path> when the new path is absent.
nest_volume() {
  local dir="$1" rel="$2"
  [[ -d "$dir" ]] || return 0
  [[ -e "$dir/$rel" ]] && return 0
  local top="${rel%%/*}"
  [[ -n "$top" && -e "$dir/$top" ]] && return 0
  if ! find "$dir" -mindepth 1 -maxdepth 1 -print -quit | grep -q .; then
    return 0
  fi
  local parent base tmp
  parent="$(dirname "$dir")"
  base="$(basename "$dir")"
  tmp="$parent/.migrate-$base"
  [[ -e "$tmp" ]] && tmp="$parent/.migrate-$base-$$"
  mv "$dir" "$tmp"
  mkdir -p "$(dirname "$dir/$rel")"
  mv "$tmp" "$dir/$rel"
}

migrate_sidecar_data() {
  local d="$BROS_HOST_DATA_DIR"
  local custom="${SIDECARS_DIR:-$REPO_ROOT/sidecars}/custom"
  local child name
  nest_volume "$d/ollama" "root/.ollama"
  move_if_missing "$d/ollama-config" "$d/ollama/root/.config/ollama"
  move_if_missing "$d/bros-model" "$d/ollama/bros-model"
  nest_volume "$d/opencode" "workspace"
  move_if_missing "$d/opencode-config" "$d/opencode/root/.config/opencode"
  move_if_missing "$d/opencode-share" "$d/opencode/root/.local/share/opencode"
  nest_volume "$d/openwebui" "app/backend/data"
  move_if_missing "$d/firecrawl-redis" "$d/firecrawl/data"
  move_if_missing "$d/firecrawl-rabbitmq" "$d/firecrawl/var/lib/rabbitmq"
  move_if_missing "$d/firecrawl-pg" "$d/firecrawl/var/lib/postgresql/data"
  nest_volume "$d/whisper" "home/ubuntu/.cache/huggingface/hub"
  mkdir -p "$custom"
  if [[ -d "$d/sidecars" ]]; then
    for child in "$d/sidecars"/*; do
      [[ -e "$child" ]] || continue
      name="$(basename "$child")"
      move_if_missing "$child" "$custom/$name"
    done
  fi
  if [[ -d "$d/sidecar-repos" ]]; then
    for child in "$d/sidecar-repos"/*; do
      [[ -e "$child" ]] || continue
      name="$(basename "$child")"
      move_if_missing "$child" "$custom/$name"
    done
  fi
}

ensure_host_data_dir() {
  migrate_sidecar_data
  mkdir -p \
    "$BROS_HOST_DATA_DIR" \
    "$BROS_HOST_DATA_DIR/ollama/root/.ollama" \
    "$BROS_HOST_DATA_DIR/ollama/root/.config/ollama" \
    "$BROS_HOST_DATA_DIR/ollama/bros-model" \
    "$BROS_HOST_DATA_DIR/openwebui/app/backend/data" \
    "$BROS_HOST_DATA_DIR/opencode/workspace" \
    "$BROS_HOST_DATA_DIR/opencode/root/.config/opencode" \
    "$BROS_HOST_DATA_DIR/opencode/root/.local/share/opencode" \
    "$BROS_HOST_DATA_DIR/whisper/home/ubuntu/.cache/huggingface/hub" \
    "$BROS_HOST_DATA_DIR/logs" \
    "$BROS_HOST_DATA_DIR/tunnel" \
    "${SIDECARS_DIR:-$REPO_ROOT/sidecars}/custom"
}

compose_files() {
  if [[ "$DEV" -eq 1 ]]; then
    echo "-f docker-compose.yml -f docker-compose.dev.yml"
  else
    echo "-f docker-compose.yml -f docker-compose.prod.yml"
  fi
}

# Run docker compose with selected files; remaining args passed through.
compose() {
  # shellcheck disable=SC2046
  docker compose $(compose_files) "$@"
}

# Dev start skips --build (bind-mount; compose builds only if bros:dev is missing).
# Prod always --build so the baked image stays current.
# Explicit rebuild/pull: BROS_DEV=1 ./bros update  (pnpm dev:update)
compose_up() {
  if [[ "$DEV" -eq 1 ]]; then
    compose up "$@"
  else
    compose up --build "$@"
  fi
}

# Core sidecars live under ./sidecars/core/<id>/ with compose project bros-sc-<id>.
SIDECARS_DIR="$REPO_ROOT/sidecars"
OLLAMA_COMPOSE="$SIDECARS_DIR/core/ollama/docker-compose.yml"
VENDOR_MODEL_DIR="$REPO_ROOT/vendor/bros-model"
GGUF_REL="models/bros-q4_k_m.gguf"
STAMP_NAME=".bros-gguf-stamp.json"

# Tear down one compose project by name (ignore missing).
compose_project_down() {
  local project="$1"
  local file="${2:-}"
  if [[ -n "$file" && -f "$file" ]]; then
    docker compose -p "$project" -f "$file" down --timeout 10 --remove-orphans >/dev/null 2>&1 || true
  else
    docker compose -p "$project" down --timeout 10 --remove-orphans >/dev/null 2>&1 || true
  fi
}

# Compose files under sidecars/{core,addon,custom} and custom/<repo>/sidecars/.
each_sidecar_compose() {
  local root="$1"
  local kind dir nested
  [[ -d "$root" ]] || return 0
  for kind in core addon custom; do
    [[ -d "$root/$kind" ]] || continue
    for dir in "$root/$kind"/*/; do
      [[ -d "$dir" ]] || continue
      if [[ -f "${dir}docker-compose.yml" ]]; then
        printf '%s\n' "${dir}docker-compose.yml"
      fi
      if [[ -d "${dir}sidecars" ]]; then
        for nested in "${dir}sidecars"/*/; do
          [[ -f "${nested}docker-compose.yml" ]] || continue
          printf '%s\n' "${nested}docker-compose.yml"
        done
      fi
    done
  done
}

# Stop all Bros sidecar projects (bros-sc-*) discovered under sidecars/.
stop_bros_sidecars() {
  local file id
  while IFS= read -r file; do
    [[ -n "$file" ]] || continue
    id="$(basename "$(dirname "$file")")"
    compose_project_down "bros-sc-${id}" "$file"
  done < <(each_sidecar_compose "$SIDECARS_DIR")
  # Catch any leftover bros-sc-* containers (custom data_dir sidecars, stale names).
  local leftover
  leftover="$(docker ps -aq --filter 'name=bros-sc-' 2>/dev/null || true)"
  if [[ -n "$leftover" ]]; then
    # shellcheck disable=SC2086
    docker stop $leftover >/dev/null 2>&1 || true
    # shellcheck disable=SC2086
    docker rm $leftover >/dev/null 2>&1 || true
  fi
}

# One-shot cleanup of pre-rename forgebox-sc-* stacks so they never run beside bros-sc-*.
cleanup_legacy_sidecar_projects() {
  local file id leftover
  while IFS= read -r file; do
    [[ -n "$file" ]] || continue
    id="$(basename "$(dirname "$file")")"
    compose_project_down "forgebox-sc-${id}" "$file"
  done < <(each_sidecar_compose "$SIDECARS_DIR")
  leftover="$(docker ps -aq --filter 'name=forgebox-sc-' 2>/dev/null || true)"
  if [[ -n "$leftover" ]]; then
    echo "Removing legacy forgebox-sc-* containers…"
    # shellcheck disable=SC2086
    docker stop $leftover >/dev/null 2>&1 || true
    # shellcheck disable=SC2086
    docker rm $leftover >/dev/null 2>&1 || true
  fi
}

stop_full_stack() {
  echo "Stopping host tunnel helper…"
  bros_tunnel_stop_helper
  bros_tunnel_cleanup_sidecar
  echo "Stopping sidecars (bros-sc-*)…"
  stop_bros_sidecars
  cleanup_legacy_sidecar_projects
  echo "Stopping Bros core…"
  compose down || true
}

apply_config_env() {
  local candidate=""
  if [[ -n "$CONFIG_PATH" ]]; then
    candidate="$CONFIG_PATH"
  else
    candidate="$(resolve_default_config || true)"
  fi
  if [[ -z "$candidate" ]]; then
    return 0
  fi
  local abs
  if [[ "$candidate" = /* ]]; then
    abs="$candidate"
  else
    abs="$(cd "$(dirname "$candidate")" && pwd)/$(basename "$candidate")"
  fi
  [[ -f "$abs" ]] || die "config file not found: $candidate"
  export BROS_CONFIG_HOST="$abs"
  # Path inside container (compose mounts host file at /app/bros.yml)
  export BROS_CONFIG="/app/bros.yml"
}

# Interactive start: on SIGINT/SIGTERM, tear down core + sidecars (no orphan stack).
on_interactive_signal() {
  echo "" >&2
  echo "Stopping Bros (full stack)…" >&2
  trap - INT TERM
  if [[ -n "${COMPOSE_UP_PID:-}" ]]; then
    kill -INT "$COMPOSE_UP_PID" 2>/dev/null || true
    wait "$COMPOSE_UP_PID" 2>/dev/null || true
    unset COMPOSE_UP_PID
  fi
  stop_full_stack
  exit 130
}

gguf_path() {
  printf '%s\n' "$VENDOR_MODEL_DIR/$GGUF_REL"
}

stamp_path() {
  printf '%s\n' "${BROS_HOST_DATA_DIR}/ollama/bros-model/${STAMP_NAME}"
}

vendor_stamp_json() {
  local gguf="$1"
  if command -v python3 >/dev/null 2>&1; then
    python3 -c 'import json,os,sys; s=os.stat(sys.argv[1]); print(json.dumps({"size": s.st_size, "mtimeMs": s.st_mtime * 1000}))' "$gguf"
    return 0
  fi
  local size mtime
  size="$(stat -c%s "$gguf" 2>/dev/null || stat -f%z "$gguf")"
  mtime="$(stat -c%Y "$gguf" 2>/dev/null || stat -f%m "$gguf")"
  printf '{"size":%s,"mtimeMs":%s000}\n' "$size" "$mtime"
}

stamp_is_current() {
  local gguf dest identity
  gguf="$(gguf_path)"
  dest="$(stamp_path)"
  [[ -f "$gguf" && -f "$dest" ]] || return 1
  identity="$(vendor_stamp_json "$gguf")"
  if command -v python3 >/dev/null 2>&1; then
    if python3 -c 'import json,sys
a=json.loads(open(sys.argv[1],encoding="utf-8").read())
b=json.loads(sys.argv[2])
raise SystemExit(0 if a.get("size")==b.get("size") and a.get("mtimeMs")==b.get("mtimeMs") else 1)' "$dest" "$identity"; then
      return 0
    fi
    return 1
  fi
  local dest_size ident_size
  dest_size="$(sed -n 's/.*"size":[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$dest" | head -1)"
  ident_size="$(sed -n 's/.*"size":[[:space:]]*\([0-9][0-9]*\).*/\1/p' <<<"$identity" | head -1)"
  [[ -n "$dest_size" && "$dest_size" == "$ident_size" ]]
}

sidecar_has_bros_model() {
  local port tags
  port="${BROS_OLLAMA_PORT:-11435}"
  tags="$(curl -sf --max-time 3 "http://127.0.0.1:${port}/api/tags" 2>/dev/null || true)"
  [[ -n "$tags" ]] || return 1
  echo "$tags" | grep -qE '"name"[[:space:]]*:[[:space:]]*"bros("|:)'
}

ollama_publish_up() {
  local port="${BROS_OLLAMA_PORT:-11435}"
  curl -sf --max-time 2 "http://127.0.0.1:${port}/api/version" >/dev/null 2>&1
}

ensure_vendor_submodule() {
  if [[ -f "$(gguf_path)" || -f "$VENDOR_MODEL_DIR/scripts/install-ollama.sh" ]]; then
    return 0
  fi
  if git -C "$REPO_ROOT" rev-parse --git-dir >/dev/null 2>&1; then
    echo "Updating vendor/bros-model submodule…"
    git -C "$REPO_ROOT" submodule update --init --depth 1 vendor/bros-model || true
  fi
}

copy_vendor_bros_model() {
  local dest="$BROS_HOST_DATA_DIR/ollama/bros-model"
  local part
  mkdir -p "$dest"
  for part in models ollama scripts; do
    if [[ -d "$VENDOR_MODEL_DIR/$part" ]]; then
      rm -rf "$dest/$part"
      cp -a "$VENDOR_MODEL_DIR/$part" "$dest/$part"
    fi
  done
}

# Shared by core + sidecars (compose marks it external). dockerode createNetwork
# leaves no compose labels; core must not try to own this network.
ensure_bros_network() {
  local net="${BROS_NETWORK:-bros}"
  if docker network inspect "$net" >/dev/null 2>&1; then
    return 0
  fi
  docker network create --driver bridge "$net" >/dev/null
}

wait_for_ollama() {
  local port i
  port="${BROS_OLLAMA_PORT:-11435}"
  for i in $(seq 1 60); do
    if curl -sf --max-time 2 "http://127.0.0.1:${port}/api/version" >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
  done
  echo "warning: Ollama sidecar not reachable at http://127.0.0.1:${port}/api/version" >&2
  return 1
}

start_ollama_sidecar() {
  [[ -f "$OLLAMA_COMPOSE" ]] || {
    echo "warning: missing $OLLAMA_COMPOSE" >&2
    return 1
  }
  echo "Starting Ollama sidecar (bros-sc-ollama)…"
  docker compose -p bros-sc-ollama -f "$OLLAMA_COMPOSE" up -d --remove-orphans
}

install_internal_bros_model() {
  local dest gguf identity
  dest="$BROS_HOST_DATA_DIR/ollama/bros-model"
  gguf="$(gguf_path)"
  copy_vendor_bros_model
  echo "Creating Ollama model bros…"
  local exec_rc=0
  if command -v timeout >/dev/null 2>&1; then
    timeout 180 docker compose -p bros-sc-ollama -f "$OLLAMA_COMPOSE" exec -T ollama \
      bash /bros-model/scripts/install-ollama.sh || exec_rc=$?
  else
    docker compose -p bros-sc-ollama -f "$OLLAMA_COMPOSE" exec -T ollama \
      bash /bros-model/scripts/install-ollama.sh || exec_rc=$?
  fi
  if [[ "$exec_rc" -ne 0 ]]; then
    echo "warning: internal bros model create failed" >&2
    return 1
  fi
  identity="$(vendor_stamp_json "$gguf")"
  mkdir -p "$dest"
  printf '%s\n' "$identity" >"$dest/$STAMP_NAME"
}

# Sidecar Ollama + packaged model bros. Warn on miss; do not fail start.
ensure_ollama_and_model() {
  ensure_vendor_submodule
  ensure_bros_network || return 0
  start_ollama_sidecar || return 0
  wait_for_ollama || return 0
  local gguf
  gguf="$(gguf_path)"
  if [[ ! -f "$gguf" ]]; then
    echo "warning: internal bros model: missing packaged model: $gguf" >&2
    return 0
  fi
  if sidecar_has_bros_model && stamp_is_current; then
    echo "Internal model bros is current."
    return 0
  fi
  install_internal_bros_model || true
}

model_needs_update() {
  local gguf
  gguf="$(gguf_path)"
  [[ -f "$gguf" ]] || return 1
  stamp_is_current || return 0
  if ollama_publish_up; then
    sidecar_has_bros_model || return 0
  fi
  return 1
}

cmd_start() {
  apply_config_env
  # Never run forgebox-era sidecars beside bros-sc-*.
  cleanup_legacy_sidecar_projects
  bros_tunnel_cleanup_sidecar
  bros_tunnel_startup
  local mode
  mode="$([[ "$DEV" -eq 1 ]] && echo dev || echo prod)"
  ensure_bros_network
  if [[ "$DAEMON" -eq 1 ]]; then
    echo "Bros start ($mode, daemon)…"
    compose_up -d
    ensure_ollama_and_model || true
    return
  fi

  echo "Bros start ($mode, interactive)…"
  echo "Ctrl+C stops the full stack (core + sidecars)."
  # Background + wait so this shell's INT/TERM trap always runs.
  trap on_interactive_signal INT TERM
  compose_up &
  COMPOSE_UP_PID=$!
  sleep 2
  if kill -0 "$COMPOSE_UP_PID" 2>/dev/null; then
    ensure_ollama_and_model || true
  fi
  set +e
  wait "$COMPOSE_UP_PID"
  local rc=$?
  set -e
  unset COMPOSE_UP_PID
  trap - INT TERM
  # Signal path usually exits via trap (130). If wait saw 130/143 without trap, still down.
  if [[ $rc -eq 130 || $rc -eq 143 ]]; then
    echo "Stopping Bros (full stack)…" >&2
    stop_full_stack
    exit "$rc"
  fi
  return "$rc"
}

cmd_stop() {
  echo "Bros stop (core + sidecars)…"
  stop_full_stack
}

cmd_status() {
  compose ps
  local port="${BROS_PORT:-3055}"
  echo
  if curl -sf --max-time 3 "http://127.0.0.1:${port}/api/health" >/dev/null 2>&1; then
    echo "Health: ok (http://127.0.0.1:${port}/api/health)"
  else
    echo "Health: unreachable (http://127.0.0.1:${port}/api/health)"
  fi
  if ollama_publish_up; then
    if sidecar_has_bros_model; then
      echo "Ollama sidecar: up (model bros installed)"
    else
      echo "Ollama sidecar: up (model bros missing)"
    fi
  else
    echo "Ollama sidecar: down"
  fi
}

cmd_restart() {
  cmd_stop
  cmd_start
}

update_hint() {
  if [[ "$DEV" -eq 1 ]]; then
    echo "pnpm dev:update"
  else
    echo "bros update"
  fi
}

restart_hint() {
  if [[ "$DEV" -eq 1 ]]; then
    echo "pnpm dev"
  else
    local flags=""
    [[ "$DAEMON" -eq 1 ]] && flags=" -D"
    echo "bros restart${flags}"
  fi
}

# Exit 0 if updates available, 1 if none.
detect_updates() {
  local found=0

  echo "== Git =="
  if git -C "$REPO_ROOT" rev-parse --git-dir >/dev/null 2>&1 \
    && git -C "$REPO_ROOT" remote get-url origin >/dev/null 2>&1; then
    if git -C "$REPO_ROOT" fetch --quiet origin 2>/dev/null; then
      local behind=0
      if git -C "$REPO_ROOT" rev-parse '@{u}' >/dev/null 2>&1; then
        behind="$(git -C "$REPO_ROOT" rev-list --count 'HEAD..@{u}' 2>/dev/null || echo 0)"
      else
        local ref=""
        for cand in origin/HEAD origin/main origin/master; do
          if git -C "$REPO_ROOT" rev-parse "$cand" >/dev/null 2>&1; then
            ref="$cand"
            break
          fi
        done
        [[ -n "$ref" ]] && behind="$(git -C "$REPO_ROOT" rev-list --count "HEAD..$ref" 2>/dev/null || echo 0)"
      fi
      if [[ "${behind:-0}" -gt 0 ]]; then
        echo "Behind remote by $behind commit(s)."
        found=1
      else
        echo "Up to date with remote (or no tracking branch)."
      fi
    else
      echo "Could not fetch remote. Skipped."
    fi
  else
    echo "No git remote (or not a repo). Skipped."
  fi

  echo
  echo "== Images =="
  local pull_out pull_rc
  set +e
  pull_out="$(compose pull --dry-run 2>&1)"
  pull_rc=$?
  set -e
  if [[ $pull_rc -eq 0 ]]; then
    if echo "$pull_out" | grep -qiE ' Pulled|would pull|Downloading|download'; then
      echo "Image updates available (compose pull --dry-run)."
      echo "$pull_out" | tail -n 15
      found=1
    else
      echo "Images look current (compose pull --dry-run)."
    fi
  else
    echo "compose pull --dry-run unavailable; local images:"
    compose images 2>/dev/null || true
    echo "(update still pulls + rebuilds)"
  fi

  echo
  echo "== Compose / Dockerfile =="
  if git -C "$REPO_ROOT" rev-parse --git-dir >/dev/null 2>&1; then
    local dirty
    dirty="$(git -C "$REPO_ROOT" status --porcelain -- docker-compose.yml docker-compose.dev.yml docker-compose.prod.yml Dockerfile 2>/dev/null || true)"
    if [[ -n "$dirty" ]]; then
      echo "Local uncommitted compose/Dockerfile changes:"
      echo "$dirty"
      found=1
    else
      echo "Clean."
    fi
  fi

  echo
  echo "== Internal bros model =="
  if [[ ! -f "$(gguf_path)" ]]; then
    echo "Packaged GGUF missing (vendor/bros-model). Skipped."
  elif model_needs_update; then
    echo "Stamp stale or model bros missing — run update (or start) to reinstall."
    found=1
  else
    echo "Vendor GGUF stamp matches dest (or Ollama is down; start will install)."
  fi

  [[ "$found" -eq 1 ]]
}

cmd_check() {
  apply_config_env
  local rc=1
  set +e
  detect_updates
  rc=$?
  set -e
  if [[ $rc -eq 0 ]]; then
    echo
    if [[ ! -t 0 ]]; then
      echo "Updates available. Non-interactive stdin — not prompting. Run: $(update_hint)"
      return 0
    fi
    read -r -p "Updates available. Run update now? [y/N] " ans || true
    case "${ans:-}" in
      y|Y|yes|YES) cmd_update ;;
      *) echo "Skipped. Run: $(update_hint)" ;;
    esac
  else
    echo
    echo "No actionable updates detected."
  fi
}

cmd_update() {
  apply_config_env
  echo "Bros update: git pull + submodule + images…"
  if git -C "$REPO_ROOT" rev-parse --git-dir >/dev/null 2>&1 \
    && git -C "$REPO_ROOT" remote get-url origin >/dev/null 2>&1; then
    git -C "$REPO_ROOT" pull --ff-only || true
    git -C "$REPO_ROOT" submodule update --init || true
  fi
  compose pull || true
  compose build --pull
  if ollama_publish_up && [[ -f "$(gguf_path)" ]]; then
    if ! stamp_is_current || ! sidecar_has_bros_model; then
      echo "Reinstalling internal model bros…"
      install_internal_bros_model || true
    fi
  fi
  echo "Images pulled/rebuilt. Restart to run new images:"
  echo "  $(restart_hint)"
}

service_unit_dir() {
  printf '%s\n' "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
}

service_unit_path() {
  printf '%s\n' "$(service_unit_dir)/bros.service"
}

service_exec_bin() {
  local bin="${BROS_BIN:-${HOME}/.local/bin/bros}"
  if [[ -x "$bin" ]]; then
    printf '%s\n' "$bin"
    return 0
  fi
  printf '%s\n' "$BROS_HOME/bros"
}

cmd_service() {
  case "$(uname -s)" in
    Linux) ;;
    *) die "service is Linux systemd --user only" ;;
  esac
  command -v systemctl >/dev/null 2>&1 || die "systemctl not found"
  local unit dir bin
  dir="$(service_unit_dir)"
  unit="$(service_unit_path)"
  bin="$(service_exec_bin)"
  case "$SERVICE_ACTION" in
    install)
      mkdir -p "$dir"
      cat >"$unit" <<EOF
[Unit]
Description=Bros local AI control plane
After=docker.socket
Wants=docker.socket

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=BROS_HOME=${BROS_HOME}
Environment=BROS_DIR=${BROS_DIR}
Environment=BROS_HOST_DATA_DIR=${BROS_HOST_DATA_DIR}
Environment=BROS_CONFIG=${BROS_CONFIG_HOST:-${BROS_CONFIG:-$(xdg_config_path)}}
ExecStart=${bin} -D
ExecStop=${bin} stop

[Install]
WantedBy=default.target
EOF
      systemctl --user daemon-reload
      systemctl --user enable --now bros.service
      echo "Installed $unit"
      echo "Without loginctl enable-linger, this unit stops on logout."
      ;;
    uninstall)
      systemctl --user disable --now bros.service 2>/dev/null || true
      rm -f "$unit"
      systemctl --user daemon-reload 2>/dev/null || true
      echo "Removed systemd --user unit bros.service"
      ;;
    status)
      systemctl --user status bros.service --no-pager || true
      ;;
    *)
      die "unknown service action: ${SERVICE_ACTION:-} (install|uninstall|status)"
      ;;
  esac
}

# --- parse args ---
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    -v|--version)
      echo "bros $VERSION"
      exit 0
      ;;
    --dev)
      die "--dev removed. Use: pnpm dev"
      ;;
    -D|--daemon)
      DAEMON=1
      shift
      ;;
    -i|--interactive)
      DAEMON=0
      shift
      ;;
    -c|--config)
      [[ $# -ge 2 ]] || die "--config requires a PATH"
      CONFIG_PATH="$2"
      shift 2
      ;;
    start|stop|status|restart|check|update|upgrade)
      [[ -z "$COMMAND" ]] || die "only one command allowed (got '$COMMAND' and '$1')"
      COMMAND="$1"
      shift
      ;;
    service)
      [[ -z "$COMMAND" ]] || die "only one command allowed (got '$COMMAND' and '$1')"
      COMMAND="service"
      shift
      [[ $# -ge 1 ]] || die "service requires install, uninstall, or status"
      case "$1" in
        install|uninstall|status)
          SERVICE_ACTION="$1"
          shift
          ;;
        *)
          die "unknown service action: $1 (install|uninstall|status)"
          ;;
      esac
      ;;
    -*)
      die "unknown option: $1 (try --help)"
      ;;
    *)
      die "unknown argument: $1 (try --help)"
      ;;
  esac
done

[[ -n "$COMMAND" ]] || COMMAND="start"
[[ "$COMMAND" == "upgrade" ]] && COMMAND="update"

# Dev is always foreground; -D/--daemon has no effect with BROS_DEV=1.
if [[ "$DEV" -eq 1 && "$DAEMON" -eq 1 ]]; then
  echo "warning: --daemon (-D) ignored with BROS_DEV=1 (dev always interactive)" >&2
  DAEMON=0
fi

preflight
apply_config_env

case "$COMMAND" in
  start)   cmd_start ;;
  stop)    cmd_stop ;;
  status)  cmd_status ;;
  restart) cmd_restart ;;
  check)   cmd_check ;;
  update)  cmd_update ;;
  service) cmd_service ;;
  *)       die "unknown command: $COMMAND" ;;
esac
