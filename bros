#!/usr/bin/env bash
# Docker-only launcher. The host needs Docker. Node runs in the container.
# Dev is BROS_DEV=1, not a flag.
# Three entries:
#   full start — bare ./bros or start (app + sidecars)
#   one-off    — help, version, status, stop, check, update, service, restart
#   exec       — run and shell, only when bros-desktop is already up
# -h / --help prints docs/cli.md (YAML frontmatter stripped).
# --verbose shows the compose log prefix, including Image Building / Built.
# Build-step spam and the Nitro file list stay hidden. A terminal rewrites
# one status line per container; a pipe prints each state on its own line.
set -euo pipefail

# Split stdin on \r and \n. NUL records: "c"+text is a progress update (\r),
# "l"+text is a finished line (\n or CRLF). \r\n is one finished line.
# Ollama create does not send \r. It homes with CSI (\033[1G) inside a
# synchronized frame (\033[?2026h). Those homes are progress updates. A
# newline inside the frame is another row of the same redraw, not a commit.
split_records() {
  local block="" rest="" seg="" before="" lfbefore="" first=""
  local saw_cr=0 progress_in_sync=0 progress_hold="" REWRITE_OUT=""
  # Indented so the test extractor keeps this inside split_records.
  rewrite_redraws() {
    local s="$progress_hold$1" out="" head="" seq="" body="" cmd="" c=""
    local i=0 n=0 fin=0
    progress_hold=""
    while [[ -n "$s" ]]; do
      if [[ "$s" != *$'\033'* ]]; then
        if [[ "$progress_in_sync" -eq 1 ]]; then
          out+="${s//$'\n'/$'\r'}"
        else
          out+="$s"
        fi
        break
      fi
      head="${s%%$'\033'*}"
      if [[ "$progress_in_sync" -eq 1 ]]; then
        head="${head//$'\n'/$'\r'}"
      fi
      out+="$head"
      s="${s#"$head"}"
      if [[ "$s" != $'\033'* ]]; then
        break
      fi
      if (( ${#s} < 3 )) || [[ "${s:1:1}" != '[' ]]; then
        if [[ "${s:1:1}" != '[' ]]; then
          out+="${s:0:1}"
          s="${s:1}"
          continue
        fi
        progress_hold="$s"
        break
      fi
      n=${#s}
      fin=-1
      for ((i = 2; i < n; i++)); do
        c="${s:i:1}"
        if [[ "$c" == [[:alpha:]] || "$c" == '@' || "$c" == '~' ]]; then
          fin=$i
          break
        fi
      done
      if (( fin < 0 )); then
        progress_hold="$s"
        break
      fi
      seq="${s:0:fin+1}"
      body="${s:2:fin-2}"
      cmd="${s:fin:1}"
      s="${s:fin+1}"
      if [[ "$cmd" == h && "$body" == '?2026' ]]; then
        progress_in_sync=1
        continue
      fi
      if [[ "$cmd" == l && "$body" == '?2026' ]]; then
        progress_in_sync=0
        continue
      fi
      if [[ "$cmd" == G && ( -z "$body" || "$body" == 0 || "$body" == 1 ) ]]; then
        out+=$'\r'
        continue
      fi
      if [[ ( "$cmd" == H || "$cmd" == f ) && ( -z "$body" || "$body" == 1 || "$body" == '1;1' || "$body" == ';1' ) ]]; then
        out+=$'\r'
        continue
      fi
      out+="$seq"
    done
    REWRITE_OUT="$out"
  }
  while IFS= read -r -d '' -n 8192 block || [[ -n "$block" ]]; do
    rewrite_redraws "$block"
    rest="$REWRITE_OUT"
    while [[ -n "$rest" ]]; do
      if [[ "$saw_cr" -eq 1 ]]; then
        first="${rest:0:1}"
        rest="${rest:1}"
        if [[ "$first" == $'\n' ]]; then
          printf 'l%s\0' "$seg"
          seg=""
          saw_cr=0
          continue
        fi
        printf 'c%s\0' "$seg"
        seg=""
        saw_cr=0
        if [[ "$first" == $'\r' ]]; then
          saw_cr=1
          continue
        fi
        seg="$first"
      fi
      if [[ "$rest" != *$'\r'* && "$rest" != *$'\n'* ]]; then
        seg="$seg$rest"
        rest=""
        break
      fi
      before=""
      lfbefore=""
      if [[ "$rest" == *$'\r'* ]]; then
        before="${rest%%$'\r'*}"
      fi
      if [[ "$rest" == *$'\n'* ]]; then
        lfbefore="${rest%%$'\n'*}"
      fi
      if [[ "$rest" == *$'\n'* && ( "$rest" != *$'\r'* || ${#lfbefore} -lt ${#before} ) ]]; then
        printf 'l%s\0' "$seg$lfbefore"
        seg=""
        rest="${rest:$(( ${#lfbefore} + 1 ))}"
        continue
      fi
      seg="$seg$before"
      rest="${rest:$(( ${#before} + 1 ))}"
      saw_cr=1
    done
  done
  if [[ -n "$progress_hold" ]]; then
    seg+="$progress_hold"
  fi
  if [[ "$saw_cr" -eq 1 ]]; then
    printf 'c%s\0' "$seg"
  elif [[ -n "$seg" ]]; then
    printf 'l%s\0' "$seg"
  fi
}

# Cursor-movement CSI and OSC fight the [bros] prefix. Colors go too so a
# leftover clear sequence cannot pad the next line.
strip_ansi_line() {
  printf '%s\n' "$1" | sed -E $'s/\x1B\\[[?0-9;]*[[:alpha:]]//g; s/\x1B\\][^\x07]*\x07//g; s/\x1B\\][^\x1B]*\x1B\\\\//g'
}

# The stop file is created before "Stopping Bros". A build summary already
# in the pipe must not print after that line.
suppress_build_summary() {
  [[ "$1" == "Building image…" ]] || return 1
  [[ "${BROS_FILTER_STOP:-0}" == 1 ]] && return 0
  [[ -n "${BROS_FILTER_STOP_FILE:-}" && -f "${BROS_FILTER_STOP_FILE}" ]]
}

prefix_lines() {
  local blue='' reset='' clear='' tty=0
  local open=0 open_progress=0 open_key='' open_text=''
  local record kind text key final
  if [[ -t 1 ]]; then
    tty=1
    blue=$'\033[34m'
    reset=$'\033[0m'
    clear=$'\033[K'
  fi
  if [[ $# -gt 0 ]]; then
    printf '%s\n' "$*" | prefix_lines
    return
  fi
  while IFS= read -r -d '' record || [[ -n "$record" ]]; do
    [[ -z "$record" ]] && continue
    kind="${record:0:1}"
    text="${record:1}"
    text="${text%"${text##*[![:space:]]}"}"
    text="${text#"${text%%[![:space:]]*}"}"
    text="$(strip_ansi_line "$text")"
    if suppress_build_summary "$text"; then
      open=0
      open_progress=0
      open_key=""
      open_text=""
      continue
    fi
    if [[ "$kind" == c ]]; then
      [[ -z "$text" ]] && continue
      if [[ "$tty" -eq 1 ]]; then
        if [[ "$open" -eq 1 && "$open_progress" -eq 0 ]]; then
          printf '\n'
        fi
        printf '\r\033[2K%s[bros]%s %s' "$blue" "$reset" "$text"
      fi
      open=1
      open_progress=1
      open_key=""
      open_text="$text"
      continue
    fi
    if [[ "$open_progress" -eq 1 ]]; then
      final="$text"
      [[ -z "$final" ]] && final="$open_text"
      if [[ -n "$final" ]]; then
        if [[ "$tty" -eq 1 ]]; then
          printf '\r\033[2K%s[bros]%s %s\n' "$blue" "$reset" "$final"
        else
          printf '%s[bros]%s %s\n' "$blue" "$reset" "$final"
        fi
      elif [[ "$tty" -eq 1 && "$open" -eq 1 ]]; then
        printf '\n'
      fi
      open=0
      open_progress=0
      open_key=""
      open_text=""
      continue
    fi
    [[ -z "$text" ]] && continue
    if [[ "$tty" -eq 1 ]]; then
      key=""
      if [[ "$text" =~ ^(Container|Network)[[:space:]]+(.+)[[:space:]]+(Stopping|Stopped|Removing|Removed|Starting|Started|Creating|Created|Killing|Killed|Restarting|Waiting|Healthy|Unhealthy|Error|Exited|Running|Paused|Dead)$ ]]; then
        key="${BASH_REMATCH[1]} ${BASH_REMATCH[2]}"
      fi
      if [[ "$open" -eq 1 && -n "$open_key" && -n "$key" && "$key" == "$open_key" ]]; then
        printf '\r%s[bros]%s %s%s' "$blue" "$reset" "$text" "$clear"
        open=1
        open_progress=0
        open_key="$key"
        open_text="$text"
        continue
      fi
      if [[ "$open" -eq 1 ]]; then
        printf '\n'
        open=0
        open_key=""
        open_text=""
      fi
      if [[ -n "$key" ]]; then
        printf '\r%s[bros]%s %s%s' "$blue" "$reset" "$text" "$clear"
        open=1
        open_progress=0
        open_key="$key"
        open_text="$text"
        continue
      fi
    fi
    printf '%s[bros]%s %s\n' "$blue" "$reset" "$text"
    open=0
    open_progress=0
    open_key=""
    open_text=""
  done < <(split_records)
  if [[ "$tty" -eq 1 && "$open" -eq 1 ]]; then
    printf '\n'
  elif [[ "$tty" -eq 0 && "$open_progress" -eq 1 && -n "$open_text" ]]; then
    printf '%s[bros]%s %s\n' "$blue" "$reset" "$open_text"
  fi
}

# User-facing lines: one [bros] prefix is added later. Drop empty-project
# warnings, Compose timestamps, consola level words, the Nitro file list, and
# BuildKit step spam. A failed build still prints its error.
# Progress (\r) is forwarded with a trailing \r. prefix_lines is the TTY and
# redraws there. A pipe never sees that \r from prefix_lines.
filter_lines() {
  local line unwrapped build_noted=0 start_noted=0 drop_build=0
  local record kind emit_kind
  while IFS= read -r -d '' record || [[ -n "$record" ]]; do
    [[ -z "$record" ]] && continue
    kind="${record:0:1}"
    line="${record:1}"
    emit_kind="$kind"
    line="${line%"${line##*[![:space:]]}"}"
    line="${line#"${line%%[![:space:]]*}"}"
    if [[ "$line" == time=\"* ]]; then
      unwrapped="$(printf '%s\n' "$line" | sed -E 's/^time="[^"]*"[[:space:]]+level=[A-Za-z]+[[:space:]]+msg="(.*)"$/\1/')"
      if [[ "$unwrapped" != "$line" ]]; then
        line="$(printf '%s\n' "$unwrapped" | sed -E 's/\\"/"/g')"
      fi
    else
      line="$(printf '%s\n' "$line" | sed -E 's/^(WARN|WARNING|ERRO|ERROR|INFO|DEBU|FATA)\[[0-9.]+\][[:space:]]+//')"
    fi
    line="$(strip_ansi_line "$line")"
    line="${line%"${line##*[![:space:]]}"}"
    line="${line#"${line%%[![:space:]]*}"}"
    while [[ "$line" == '[bros]'* ]]; do
      line="${line#'[bros]'}"
      line="${line#"${line%%[![:space:]]*}"}"
    done
    # Stop must not summarize a flushed BuildKit step as a build. The
    # interactive trap also creates BROS_FILTER_STOP_FILE so the start
    # filter, still reading the build, drops those lines too.
    drop_build=0
    if [[ "${BROS_FILTER_STOP:-0}" == 1 ]]; then
      drop_build=1
    elif [[ -n "${BROS_FILTER_STOP_FILE:-}" && -f "${BROS_FILTER_STOP_FILE}" ]]; then
      drop_build=1
    fi
    case "$line" in
      "info "*) line="${line#info }" ;;
      "success "*) line="${line#success }" ;;
    esac
    # Ollama's last create status is the bare word. A real message stays.
    if [[ "$line" == success ]]; then
      if [[ "$emit_kind" == l ]]; then
        printf '\n'
      fi
      continue
    fi
    case "$line" in
      *"No resource found to remove"*) continue ;;
      Container\ *\ Creating|Container\ *\ Created) continue ;;
      Container\ *\ Starting|Container\ *\ Started)
        if [[ "$start_noted" -eq 0 ]]; then
          printf '%s\n' "Starting container…"
          start_noted=1
        fi
        continue
        ;;
    esac
    if [[ "${VERBOSE:-0}" != 1 && "${BROS_VERBOSE:-}" != 1 ]]; then
      case "$line" in
        Image\ *\ Building|Image\ *\ Built)
          if [[ "$drop_build" -eq 1 ]]; then
            continue
          fi
          if [[ "$line" == Image\ *\ Building && "$build_noted" -eq 0 ]]; then
            build_noted=1
            suppress_build_summary "Building image…" || printf '%s\n' "Building image…"
          fi
          continue
          ;;
      esac
    fi
    if [[ "$line" == *".output/server/chunks/"* || "$line" == *"kB gzip"* ]]; then
      continue
    fi
    if [[ "$line" =~ ^#[0-9]+([[:space:]]|\[) ]]; then
      if [[ "$line" == *ERROR* || "$line" == *"error:"* || "$line" == *"Error:"* || "$line" == *"failed"* || "$line" == *"Failed"* || "$line" == *"ERR!"* || "$line" == *ELIFECYCLE* ]]; then
        printf '%s\n' "$line"
        continue
      fi
      if [[ "$drop_build" -eq 1 ]]; then
        continue
      fi
      if [[ "$build_noted" -eq 0 ]]; then
        build_noted=1
        suppress_build_summary "Building image…" || printf '%s\n' "Building image…"
      fi
      continue
    fi
    [[ -z "$line" ]] && continue
    if [[ "$emit_kind" == c ]]; then
      printf '%s\r' "$line"
    else
      printf '%s\n' "$line"
    fi
  done < <(split_records)
}

resolve_script_dir() {
  local source="$1"
  local dir
  while [[ -L "$source" ]]; do
    dir="$(cd "$(dirname "$source")" && pwd)"
    source="$(readlink "$source")"
    [[ "$source" != /* ]] && source="$dir/$source"
  done
  cd "$(dirname "$source")" && pwd
}

SCRIPT_DIR="$(resolve_script_dir "${BASH_SOURCE[0]}")"
REPO_ROOT="$SCRIPT_DIR"
cd "$REPO_ROOT"

VERSION="0.1.0"
if [[ -f "$REPO_ROOT/src/package.json" ]]; then
  _pkg_ver="$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$REPO_ROOT/src/package.json" | head -1)"
  [[ -n "${_pkg_ver:-}" ]] && VERSION="$_pkg_ver"
fi
[[ -f "$REPO_ROOT/VERSION" ]] && VERSION="$(tr -d '[:space:]' <"$REPO_ROOT/VERSION")"

VERBOSE=0
DAEMON=0
CONFIG_PATH=""
COMMAND=""
FORWARD=()

die() {
  prefix_lines "error: $*" >&2
  exit 1
}

print_usage() {
  local file="$REPO_ROOT/docs/cli.md"
  [[ -f "$file" ]] || die "missing $file"
  awk '
    NR == 1 && $0 == "---" { skip = 1; next }
    skip && $0 == "---" { skip = 0; next }
    !skip { print }
  ' "$file"
}

# Host tunnel helper (not a sidecar). Sourced functions live in scripts/.
# shellcheck source=scripts/bros-tunnel.sh
. "$REPO_ROOT/scripts/bros-tunnel.sh"

preflight() {
  if ! command -v docker >/dev/null 2>&1; then
    die "Docker is not installed or not on PATH. Install Docker: https://docs.docker.com/get-docker/"
  fi
  if ! docker info >/dev/null 2>&1; then
    die "Docker daemon is not reachable. Start Docker and retry (tried: docker info)."
  fi
  if ! docker compose version >/dev/null 2>&1; then
    die "Docker Compose plugin missing. Need 'docker compose' (v2 plugin), not only 'docker-compose'."
  fi
  load_dotenv
  export BROS_HOST_HOME_BIND="${BROS_HOST_HOME_BIND:-${HOME}}"
  export BROS_HOST_REPO="${BROS_HOST_REPO:-$REPO_ROOT}"
  export BROS_HOST_UID="${BROS_HOST_UID:-$(id -u)}"
  export BROS_HOST_GID="${BROS_HOST_GID:-$(id -g)}"
  _docker_gid="$(getent group docker 2>/dev/null | cut -d: -f3 || true)"
  if [[ -n "${_docker_gid}" ]]; then
    export BROS_DOCKER_GID="${_docker_gid}"
  else
    export BROS_DOCKER_GID=0
    prefix_lines "warning: no docker group; BROS_DOCKER_GID=0 so the app can still use /var/run/docker.sock" >&2
  fi
  resolve_bros_dir
  load_listen_env
}

# Export every KEY=value in $REPO_ROOT/.env. Already-set shell vars win. Empty values stay unset.
load_dotenv() {
  local file="$REPO_ROOT/.env" line key val
  [[ -f "$file" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -z "$line" || "$line" == \#* ]] && continue
    [[ "$line" == export\ * ]] && line="${line#export }"
    [[ "$line" == *=* ]] || continue
    key="${line%%=*}"
    key="${key%"${key##*[![:space:]]}"}"
    [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
    [[ -n "${!key+x}" ]] && continue
    val="${line#*=}"
    val="${val#"${val%%[![:space:]]*}"}"
    val="${val%"${val##*[![:space:]]}"}"
    if [[ "$val" == \"*\" && "$val" == *\" ]]; then
      val="${val#\"}"
      val="${val%\"}"
    elif [[ "$val" == \'*\' && "$val" == *\' ]]; then
      val="${val#\'}"
      val="${val%\'}"
    fi
    [[ -z "$val" ]] && continue
    export "$key=$val"
  done <"$file"
}

load_listen_env() {
  export BROS_PORT="${BROS_PORT:-3055}"
  export BROS_HOST="${BROS_HOST:-0.0.0.0}"
}

resolve_bros_dir() {
  if [[ -z "${BROS_DIR:-}" && -z "${BROS_HOME:-}" ]]; then
    BROS_DIR="$SCRIPT_DIR"
    BROS_HOME="$SCRIPT_DIR"
  elif [[ -z "${BROS_DIR:-}" ]]; then
    BROS_DIR="$BROS_HOME"
  elif [[ -z "${BROS_HOME:-}" ]]; then
    BROS_HOME="$BROS_DIR"
  fi
  export BROS_HOME
  export BROS_DIR
  export BROS_HOST_DATA_DIR="${BROS_HOST_DATA_DIR:-${BROS_HOME}/data}"
  export BROS_BIN="${BROS_BIN:-${HOME}/.local/bin/bros}"
  # Desktop compose requires this. Host data dir, not in-container /app/data.
  if [[ -z "${BROS_HOST_WORKSPACE:-}" ]]; then
    case "${BROS_HOST_DATA_DIR}" in
      ''|/app/data|/data) ;;
      *) export BROS_HOST_WORKSPACE="${BROS_HOST_DATA_DIR}/home/workspace" ;;
    esac
  fi
}

resolve_default_config() {
  if [[ -n "${CONFIG_PATH:-}" && -f "$CONFIG_PATH" ]]; then
    printf '%s\n' "$CONFIG_PATH"
    return 0
  fi
  local data="${BROS_HOST_DATA_DIR:-${BROS_DIR:-${BROS_HOME:-}}/data}"
  if [[ -f "$data/config/bros.yml" ]]; then
    printf '%s\n' "$data/config/bros.yml"
    return 0
  fi
  if [[ -f "${BROS_DIR:-${BROS_HOME:-}}/bros.yml" ]]; then
    printf '%s\n' "${BROS_DIR:-$BROS_HOME}/bros.yml"
    return 0
  fi
  return 1
}

ensure_host_data_dir() {
  mkdir -p \
    "$BROS_HOST_DATA_DIR" \
    "$BROS_HOST_DATA_DIR/config/apps" \
    "$BROS_HOST_DATA_DIR/config/skills" \
    "$BROS_HOST_DATA_DIR/home/.local/sidecar-bins" \
    "$BROS_HOST_DATA_DIR/home/workspace" \
    "$BROS_HOST_DATA_DIR/home/.agents/skills" \
    "$BROS_HOST_DATA_DIR/sidecars/ollama/bros-model" \
    "$BROS_HOST_DATA_DIR/var/logs" \
    "$BROS_HOST_DATA_DIR/var/tunnel"
  if [[ -f "$REPO_ROOT/bros.yml" && ! -e "$BROS_HOST_DATA_DIR/config/bros.yml" ]]; then
    cp "$REPO_ROOT/bros.yml" "$BROS_HOST_DATA_DIR/config/bros.yml"
  fi
}

compose_files() {
  if [[ "$DEV" -eq 1 ]]; then
    echo "-f docker-compose.yml -f docker-compose.dev.yml"
  else
    echo "-f docker-compose.yml -f docker-compose.prod.yml"
  fi
}

compose() {
  local -a pre=()
  if [[ "${VERBOSE:-0}" != 1 ]]; then
    if [[ "${COMPOSE_PROGRESS_QUIET:-0}" == 1 ]]; then
      pre=(--progress quiet)
    else
      pre=(--progress plain)
    fi
  fi
  # shellcheck disable=SC2046
  docker compose "${pre[@]}" $(compose_files) "$@"
}

compose_up() {
  local -a args
  if [[ "$DEV" -eq 1 ]]; then
    args=(up)
  else
    args=(up --build)
  fi
  if [[ "${VERBOSE:-0}" != 1 ]]; then
    args+=(--no-log-prefix)
  fi
  compose "${args[@]}" "$@"
}

ensure_bros_network() {
  local net="${BROS_NETWORK:-bros}"
  if docker network inspect "$net" >/dev/null 2>&1; then
    return 0
  fi
  docker network create --driver bridge "$net" >/dev/null
}

ensure_bros_x11() {
  docker volume inspect bros-x11 >/dev/null 2>&1 && return 0
  docker volume create bros-x11 >/dev/null
}

apply_config_env() {
  local candidate=""
  if [[ -n "$CONFIG_PATH" ]]; then
    candidate="$CONFIG_PATH"
  else
    candidate="$(resolve_default_config || true)"
  fi
  if [[ -z "$candidate" ]]; then
    return 0
  fi
  local abs
  if [[ "$candidate" = /* ]]; then
    abs="$candidate"
  else
    abs="$(cd "$(dirname "$candidate")" && pwd)/$(basename "$candidate")"
  fi
  [[ -f "$abs" ]] || die "config file not found: $candidate"
  export BROS_CONFIG_HOST="$abs"
  export BROS_CONFIG="/app/bros.yml"
}

apps_up() {
  [[ "$(docker inspect -f '{{.State.Running}}' bros-desktop 2>/dev/null || true)" == "true" ]]
}

run_flags() {
  RUN_FLAGS=(--rm --no-deps)
  if [[ "$1" == tty && -t 0 && -t 1 ]]; then
    RUN_FLAGS+=(-it)
  else
    RUN_FLAGS+=(-T)
  fi
  if [[ -t 1 ]]; then
    RUN_FLAGS+=(-e FORCE_COLOR=1)
  fi
  if [[ "${VERBOSE:-0}" == 1 ]]; then
    RUN_FLAGS+=(-e BROS_VERBOSE=1)
  fi
  local runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  if [[ -d "$runtime" ]]; then
    RUN_FLAGS+=(-v "$runtime:$runtime")
    RUN_FLAGS+=(-e "XDG_RUNTIME_DIR=$runtime")
    RUN_FLAGS+=(-e "DBUS_SESSION_BUS_ADDRESS=unix:path=$runtime/bus")
  fi
  # Prod bundle leaves better-sqlite3 and ssh2 external. Nitro traced them.
  if [[ "$DEV" -eq 0 ]]; then
    RUN_FLAGS+=(-e NODE_PATH=/app/src/ui/.output/server/node_modules)
  fi
  if [[ -n "${BROS_HOST_WORKSPACE:-}" ]]; then
    RUN_FLAGS+=(-e "BROS_HOST_WORKSPACE=${BROS_HOST_WORKSPACE}")
  fi
}

node_argv() {
  if [[ "$DEV" -eq 1 ]]; then
    NODE_ARGV=(node --experimental-strip-types /app/src/cli/index.ts "$@")
  else
    NODE_ARGV=(/usr/local/lib/bros-cli.mjs "$@")
  fi
}

run_node() {
  node_argv "$@"
  local -a cmd
  if [[ "${1:-}" == "run" || "${1:-}" == "shell" ]]; then
    run_flags tty
    if [[ "$DEV" -eq 1 ]]; then
      compose run "${RUN_FLAGS[@]}" bros "${NODE_ARGV[@]}"
    else
      compose run "${RUN_FLAGS[@]}" --entrypoint node bros "${NODE_ARGV[@]}"
    fi
    return
  fi
  run_flags pipe
  # Compose v5 `run` has no `--no-build`. `run` does not build unless `--build` is set.
  if [[ "$DEV" -eq 1 ]]; then
    cmd=(compose run "${RUN_FLAGS[@]}" bros "${NODE_ARGV[@]}")
  else
    cmd=(compose run "${RUN_FLAGS[@]}" --entrypoint node bros "${NODE_ARGV[@]}")
  fi
  # prefix_lines waits for a NUL-sized chunk, so a quiet docker build looks stuck.
  if [[ "$COMMAND" == update || "$COMMAND" == upgrade ]]; then
    "${cmd[@]}"
    return
  fi
  "${cmd[@]}" 2>&1 | prefix_lines
}

exec_node() {
  node_argv "$@"
  local -a env=()
  if [[ -t 1 ]]; then
    env+=(-e FORCE_COLOR=1)
  fi
  if [[ "${VERBOSE:-0}" == 1 ]]; then
    env+=(-e BROS_VERBOSE=1)
  fi
  if [[ "$DEV" -eq 0 ]]; then
    env+=(-e NODE_PATH=/app/src/ui/.output/server/node_modules)
  fi
  if [[ -n "${BROS_HOST_WORKSPACE:-}" ]]; then
    env+=(-e "BROS_HOST_WORKSPACE=${BROS_HOST_WORKSPACE}")
  fi
  if [[ "$DEV" -eq 1 ]]; then
    compose exec -T "${env[@]}" bros "${NODE_ARGV[@]}"
  else
    compose exec -T "${env[@]}" bros node "${NODE_ARGV[@]}"
  fi
}

# Wait up to N seconds for a background pid, then SIGKILL its tree.
# Docker and the tunnel helper must not keep the shell after Ctrl+C.
bound_wait() {
  local pid="$1" secs="$2" i=0 ticks n=0
  ticks=$(( secs * 10 ))
  while [[ "$i" -lt "$ticks" ]]; do
    if ! kill -0 "$pid" 2>/dev/null; then
      wait "$pid" 2>/dev/null || true
      return 0
    fi
    sleep 0.1
    i=$(( i + 1 ))
  done
  kill_tree "$pid"
  while [[ "$n" -lt 20 ]] && kill -0 "$pid" 2>/dev/null; do
    sleep 0.1
    n=$(( n + 1 ))
  done
  if kill -0 "$pid" 2>/dev/null; then
    disown "$pid" 2>/dev/null || true
    return 0
  fi
  wait "$pid" 2>/dev/null || true
  return 0
}

# Name filters only. `compose down` creates missing bind dirs, as root when dockerd does it.
# `rm -f` after stop: restart policy can bring a container back before a plain rm.
stop_matching() {
  local filter="$1" ids
  ids="$(docker ps -aq --filter "name=${filter}" 2>/dev/null || true)"
  [[ -n "${ids//[[:space:]]/}" ]] || return 0
  # shellcheck disable=SC2086
  if [[ "${VERBOSE:-0}" == 1 || "${BROS_VERBOSE:-}" == 1 ]]; then
    docker stop -t 10 $ids 2>&1 | prefix_lines || true
    docker rm -f $ids 2>&1 | prefix_lines || true
  else
    docker stop -t 10 $ids >/dev/null || true
    docker rm -f $ids >/dev/null || true
  fi
}

stop_containers() {
  prefix_lines "Stopping sidecars (bros-sc-*)…"
  stop_matching 'bros-sc-'
  stop_matching 'bros-desktop'
  prefix_lines "Stopping Bros core…"
  stop_matching 'bros'
}

stop_full_stack() {
  prefix_lines "Stopping host tunnel helper…"
  bros_tunnel_stop_helper &
  bound_wait "$!" 5
  # Ctrl+C during `up --build`: docker calls must not wait on the live build.
  # A plain `bros stop` is not on that path and can run to completion.
  if [[ "${BROS_STOPPING:-0}" == 1 ]]; then
    bros_tunnel_cleanup_sidecar &
    bound_wait "$!" 15
    stop_containers &
    bound_wait "$!" 40
  else
    bros_tunnel_cleanup_sidecar
    stop_containers
  fi
  prefix_lines "Bros exited."
}

# script -c calls setsid, so the build is not in our session. Killing only
# the pipeline process group leaves `docker compose` running. A foreign
# session reached through a child is killed whole; our own session is not.
kill_sid() {
  local sid="$1" self_sid="$2" p pids
  [[ -n "$sid" && -n "$self_sid" && "$sid" != "$self_sid" && "$sid" != "1" ]] || return 0
  pids="$(ps -eo pid=,sid= 2>/dev/null | awk -v s="$sid" '$2 == s { print $1 }')"
  for p in $pids; do
    [[ "$p" == "$$" || "$p" == "1" ]] && continue
    kill -KILL "$p" 2>/dev/null || true
  done
}

# Descendants first. script's command is a new session, so killing the
# pipeline process group leaves docker compose alive.
kill_tree() {
  local pid="$1" child children sid self_sid
  [[ -n "$pid" && "$pid" != "$$" && "$pid" != "1" ]] || return 0
  self_sid="$(ps -o sid= -p "$$" 2>/dev/null | tr -d '[:space:]' || true)"
  children="$(ps -o pid= --ppid "$pid" 2>/dev/null || true)"
  for child in $children; do
    sid="$(ps -o sid= -p "$child" 2>/dev/null | tr -d '[:space:]' || true)"
    if [[ -n "$self_sid" && -n "$sid" && "$sid" != "$self_sid" ]]; then
      kill_sid "$sid" "$self_sid"
    fi
    kill_tree "$child"
  done
  kill -KILL "$pid" 2>/dev/null || true
}

# SIGKILL, not INT/TERM. Compose treats both as "press Ctrl+C again to force".
kill_job() {
  local pid="${1:-}"
  [[ -n "$pid" ]] || return 0
  # Monitor mode prints "Killed" / "[1]+ Exit" when the job dies.
  set +m || true
  kill_tree "$pid"
  disown "$pid" 2>/dev/null || true
}

# Sets the flag and SIGKILLs the build/up tree. Does not block on that
# child: the trap runs inside the interrupted wait, and a live build must
# not block stop. A second signal SIGKILLs a stop that is still running.
on_interactive_signal() {
  if [[ "${BROS_STOPPING:-0}" -eq 1 ]]; then
    BROS_FORCE=1
    kill_job "${STOP_PID:-}"
    kill_job "${COMPOSE_PGID:-}"
    kill_job "${FOLLOW_PID:-}"
    kill_job "${SPIN_PID:-}"
    return 0
  fi
  BROS_STOPPING=1
  export BROS_STOPPING
  if [[ -n "${BROS_FILTER_STOP_FILE:-}" ]]; then
    : >"${BROS_FILTER_STOP_FILE}" 2>/dev/null || true
  fi
  printf '\n' >&2 || true
  prefix_lines "Stopping Bros (full stack)…" >&2 || true
  kill_job "${COMPOSE_PGID:-}"
  kill_job "${FOLLOW_PID:-}"
  kill_job "${SPIN_PID:-}"
  return 0
}

ui_listen_host() {
  local host="${BROS_HOST:-0.0.0.0}"
  if [[ "$host" == "0.0.0.0" || "$host" == "::" || "$host" == "[::]" ]]; then
    host="127.0.0.1"
  fi
  printf '%s' "$host"
}

ui_listen_url() {
  printf 'http://%s:%s' "$(ui_listen_host)" "${BROS_PORT:-3055}"
}

# Global host addresses, skipping Docker bridges. Empty when BROS_HOST is one address.
ui_lan_urls() {
  local port="${BROS_PORT:-3055}" host="${BROS_HOST:-0.0.0.0}" iface cidr ip
  [[ "$host" == "0.0.0.0" || "$host" == "::" || "$host" == "[::]" ]] || return 0
  command -v ip >/dev/null 2>&1 || return 0
  while read -r iface cidr; do
    case "$iface" in
      lo|docker*|br-*|veth*|tun*|tailscale*|zt*) continue ;;
    esac
    ip="${cidr%%/*}"
    case "$ip" in
      ''|127.*) continue ;;
    esac
    printf 'http://%s:%s\n' "$ip" "$port"
  done < <(ip -4 -o addr show scope global | awk '{print $2, $4}')
}

ui_is_up() {
  command -v curl >/dev/null 2>&1 || return 1
  curl -fsS -o /dev/null --max-time 1 "$(ui_listen_url)/api/health" 2>/dev/null
}

# Spinner until /api/health, then the listen URL and the tunnel URL when set.
spin_until_ui() {
  local -a frames=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
  local i=0 blue='' reset='' url tunnel
  if [[ -t 1 ]]; then
    blue=$'\033[34m'
    reset=$'\033[0m'
  fi
  if ! command -v curl >/dev/null 2>&1; then
    prefix_lines "$(ui_listen_url)"
    while IFS= read -r url; do
      [[ -n "$url" ]] && prefix_lines "$url"
    done < <(ui_lan_urls)
    tunnel="$(bros_tunnel_advertised_url || true)"
    [[ -n "$tunnel" ]] && prefix_lines "$tunnel"
    return 0
  fi
  while ! ui_is_up; do
    if [[ -n "${BROS_FILTER_STOP_FILE:-}" && -f "${BROS_FILTER_STOP_FILE}" ]]; then
      [[ -t 1 ]] && printf '\r\033[2K'
      return 1
    fi
    if [[ "${DAEMON:-0}" -eq 1 && "$i" -gt 600 ]]; then
      break
    fi
    if [[ -t 1 ]]; then
      printf '\r\033[2K%s[bros]%s Starting UI… %s' "$blue" "$reset" "${frames[i % 10]}"
    elif [[ "$i" -eq 0 ]]; then
      prefix_lines "Starting UI…"
    fi
    i=$((i + 1))
    sleep 0.1
  done
  [[ -t 1 ]] && printf '\r\033[2K'
  url="$(ui_listen_url)"
  if ui_is_up; then
    prefix_lines "$url"
    while IFS= read -r url; do
      [[ -n "$url" ]] && prefix_lines "$url"
    done < <(ui_lan_urls)
  else
    prefix_lines "UI not ready yet: $url"
  fi
  tunnel="$(bros_tunnel_advertised_url || true)"
  [[ -n "$tunnel" ]] && prefix_lines "$tunnel"
}

cmd_start() {
  ensure_host_data_dir
  apply_config_env
  bros_tunnel_cleanup_sidecar
  bros_tunnel_startup
  local mode body rc
  mode="$([[ "$DEV" -eq 1 ]] && echo dev || echo prod)"
  ensure_bros_network
  ensure_bros_x11
  if [[ "$DAEMON" -eq 1 ]]; then
    prefix_lines "Bros start ($mode, daemon)…"
    compose_up -d 2>&1 | filter_lines | prefix_lines
    spin_until_ui || true
    exec_node start 2>&1 | filter_lines | prefix_lines || prefix_lines "warning: start follow-up failed" >&2
    return
  fi

  prefix_lines "Bros start ($mode, interactive)…"
  prefix_lines "Ctrl+C stops the full stack (core + sidecars)."
  BROS_STOPPING=0
  BROS_FORCE=0
  unset COMPOSE_PGID STOP_PID FOLLOW_PID || true
  # Absent until the trap creates it. The start log filter drops build
  # steps once this file exists, including lines already in flight.
  BROS_FILTER_STOP_FILE="$(mktemp)"
  rm -f "$BROS_FILTER_STOP_FILE"
  export BROS_FILTER_STOP_FILE
  trap on_interactive_signal INT TERM
  set +e
  spin_until_ui &
  SPIN_PID=$!
  # Own process group for the attach so the terminal SIGINT hits this
  # shell. The readers inherit no stop trap; SIGKILL from kill_job is
  # what ends them.
  set -m +b
  (
    set +m
    trap - INT TERM
    while true; do
      if compose exec -T bros true >/dev/null 2>&1; then
        exec_node start 2>&1 | filter_lines | prefix_lines || prefix_lines "warning: start follow-up failed" >&2
        exit 0
      fi
      sleep 2
    done
  ) &
  FOLLOW_PID=$!
  (
    set +m
    trap - INT TERM
    if [[ -t 1 ]] && command -v script >/dev/null 2>&1; then
      body="$(declare -f compose compose_files compose_up)"
      body+=$'\n'"cd $(printf '%q' "$REPO_ROOT") && DEV=${DEV} VERBOSE=${VERBOSE:-0} compose_up"
      # /dev/null stdin: script must not put the user tty in raw mode.
      # The pty is only so Compose still emits carriage-return redraws.
      script -qefc "bash --noprofile --norc -c $(printf '%q' "$body")" /dev/null </dev/null | filter_lines | prefix_lines
    else
      compose_up 2>&1 | filter_lines | prefix_lines
    fi
  ) 2>/dev/null &
  COMPOSE_PGID=$!
  wait "$COMPOSE_PGID"
  rc=$?
  if [[ "${BROS_STOPPING:-0}" -eq 1 || $rc -eq 130 || $rc -eq 143 ]]; then
    if [[ "${BROS_STOPPING:-0}" -ne 1 ]]; then
      printf '\n' >&2
      prefix_lines "Stopping Bros (full stack)…" >&2 || true
    fi
    # wait already returned on the signal. Kill anything the trap missed
    # (script's session) and do not wait for the build child to exit.
    kill_job "${COMPOSE_PGID:-}"
    kill_job "${FOLLOW_PID:-}"
    kill_job "${SPIN_PID:-}"
    unset FOLLOW_PID SPIN_PID || true
    set -m +b || true
    (
      set +m
      trap - INT TERM
      stop_full_stack
    ) &
    STOP_PID=$!
    if [[ "${BROS_FORCE:-0}" -eq 1 ]]; then
      kill_job "$STOP_PID"
    fi
    if [[ -n "${COMPOSE_PGID:-}" ]]; then
      disown "$COMPOSE_PGID" 2>/dev/null || true
    fi
    set +m || true
    wait "$STOP_PID" || true
    if [[ -n "${COMPOSE_PGID:-}" ]] && ! kill -0 "$COMPOSE_PGID" 2>/dev/null; then
      wait "$COMPOSE_PGID" 2>/dev/null || true
    fi
    rm -f "${BROS_FILTER_STOP_FILE:-}"
    trap - INT TERM
    set +m || true
    if [[ "${BROS_FORCE:-0}" -eq 1 ]]; then
      exit 130
    fi
    exit 0
  fi
  kill_job "${FOLLOW_PID:-}"
  kill_job "${SPIN_PID:-}"
  unset FOLLOW_PID SPIN_PID || true
  rm -f "${BROS_FILTER_STOP_FILE:-}"
  trap - INT TERM
  set +m || true
  set -e
  return "$rc"
}

cmd_stop() {
  prefix_lines "Bros stop (core + sidecars)…"
  stop_full_stack
}

load_dotenv
DEV=0
[[ "${BROS_DEV:-}" == "1" ]] && DEV=1

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      print_usage
      exit 0
      ;;
    -v|--version)
      echo "bros $VERSION"
      exit 0
      ;;
    --dev)
      DEV=1
      export BROS_DEV=1
      shift
      ;;
    --verbose)
      VERBOSE=1
      shift
      ;;
    -D|--daemon)
      DAEMON=1
      FORWARD+=("$1")
      shift
      ;;
    -i|--interactive)
      DAEMON=0
      FORWARD+=("$1")
      shift
      ;;
    -c|--config)
      [[ $# -ge 2 ]] || die "--config requires a PATH"
      CONFIG_PATH="$2"
      FORWARD+=("$1" "$2")
      shift 2
      ;;
    start|stop|status|restart|check|update|upgrade|service|run|shell)
      if [[ -z "$COMMAND" ]]; then
        COMMAND="$1"
      fi
      FORWARD+=("$1")
      shift
      if [[ "$COMMAND" == "run" || "$COMMAND" == "shell" ]]; then
        FORWARD+=("$@")
        break
      fi
      ;;
    *)
      FORWARD+=("$1")
      shift
      ;;
  esac
done

if [[ "$DEV" -eq 1 && "$DAEMON" -eq 1 ]]; then
  if [[ -z "$COMMAND" || "$COMMAND" == "start" || "$COMMAND" == "restart" ]]; then
    prefix_lines "warning: -D ignored when BROS_DEV=1; dev stays interactive" >&2
    DAEMON=0
  fi
fi

export BROS_DAEMON="$DAEMON"
export BROS_VERBOSE="$VERBOSE"
preflight
apply_config_env

# full start, one-off, or exec into a running bros-desktop
case "${COMMAND}" in
  ""|start)
    cmd_start
    ;;
  restart)
    cmd_stop
    cmd_start
    ;;
  stop)
    cmd_stop
    ;;
  run|shell)
    apps_up || die "bros-desktop is not running. Start Bros first: bros"
    run_node "${FORWARD[@]}"
    ;;
  update|upgrade)
    # The CLI that writes the Desktop Dockerfile is inside the image.
    # Build that image before the one-off container, or update keeps the previous CLI.
    compose build
    run_node "${FORWARD[@]}"
    ;;
  *)
    run_node "${FORWARD[@]}"
    ;;
esac
